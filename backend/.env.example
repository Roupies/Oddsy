# Configuration Backend FastAPI
DEBUG=false
API_VERSION=1.0

# Pipeline triggers (désactivé par défaut en prod)
ENABLE_PIPELINE_TRIGGERS=false

# Git version (injecté en CI/CD)
GIT_SHA=unknown

# CORS origins (ajuster selon environnement)
# CORS_ORIGINS=["http://localhost:3000","https://oddsy.vercel.app"]

# Frontend Revalidation (for ISR after predictions publish)
FRONTEND_URL=http://localhost:3000
REVALIDATION_SECRET=your_revalidation_secret_here_change_in_production
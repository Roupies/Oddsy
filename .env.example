# =====================================================
# ODDSY ENVIRONMENT VARIABLES
# =====================================================
# Copy this file to .env and customize the values

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=oddsy_football
POSTGRES_USER=oddsy_user
POSTGRES_PASSWORD=oddsy_password

# pgAdmin Configuration  
PGADMIN_EMAIL=admin@oddsy.local
PGADMIN_PASSWORD=admin_password

# Application Settings
DEBUG=True
LOG_LEVEL=INFO

# Model Settings
DEFAULT_MODEL_VERSION=v2.3
PREDICTION_CONFIDENCE_THRESHOLD=0.45

# API Settings (if needed later)
API_HOST=localhost
API_PORT=8000
API_SECRET_KEY=your-secret-key-here

# Data Sources
EPL_DATA_URL=https://example.com/api/epl-data
BETTING_ODDS_API_KEY=your-odds-api-key-here
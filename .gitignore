# Oddsy Production .gitignore

# Development and experimental files (GitHub demo focuses on /prod only)
/dev/
/rest/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.coverage

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Node.js (frontend)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js
.next/
out/

# Logs and temporary files
logs/
*.log
temp/
tmp/
*.tmp

# Configuration secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
*.key
*.pem
secrets/
credentials/

# Demo setup instructions (contains passwords)
SETUP_INSTRUCTIONS.md

# ML model artifacts (large files - exclude from main branch)
*.joblib
*.pkl
*.model
*.h5
*.weights

# Data files (exclude large datasets from main branch)
data/raw/
data/cache/
*.csv.large

# Test results and temporary analysis
test_results_*/
temp_analysis/

# Build artifacts
build/
dist/
*.egg-info/

# Monitoring data
prometheus_data/
grafana_data/

# Database backups
*.sql.backup
database/backups/

# Docker overrides
docker-compose.override.yml

# CLAUDE.md - INCLUDE in repository
# This file contains project documentation and should be tracked
!CLAUDE.md